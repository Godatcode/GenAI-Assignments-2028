# ──────────────────────────────────────────────────────────────────────────────
# LLM (generation) — Anthropic Claude Sonnet 4.6
# Get a key from https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────────────────────────────────────
# Embeddings — OpenAI text-embedding-3-large (3072 dims)
# Get a key from https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional override — defaults to text-embedding-3-large
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ──────────────────────────────────────────────────────────────────────────────
# Vector DB — Qdrant Cloud
# Sign up at https://cloud.qdrant.io and grab the cluster URL + API key
# Local fallback: http://localhost:6333 (no API key needed)
# ──────────────────────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=notebooklm-docs
